# bull-terra — local secrets (gitignored). Copy to .env and fill in.
# Secrets stay OFF the Google Sheet and OFF git (PRD §14).
#
# bull-terra stores only the *names* of these vars on each environment, as a map
# of KEY -> .env var name. Register them with --var (and the --user-var/--pass-var
# sugar for the common login):
#   env add app-a stg <url> \
#     --user-var APP_A_STG_USER \      # = --var USER=APP_A_STG_USER
#     --pass-var APP_A_STG_PASS \      # = --var PASS=APP_A_STG_PASS
#     --var API_KEY=APP_A_STG_KEY
# The values live here. At run time bull-terra reads each named var and injects it
# as BULL_TERRA_<KEY> (USER -> BULL_TERRA_USER, API_KEY -> BULL_TERRA_API_KEY …),
# so global-setup never hardcodes which env it's logging into.
#
# Convention: APP_<PROJECT>_<ENV>_<KEY> — but any names you register work.
# Several environments may point at the same vars to share a login.

# ── app-a ───────────────────────────────────────────────────────────────────
APP_A_LOCAL_USER=
APP_A_LOCAL_PASS=

APP_A_STG_USER=
APP_A_STG_PASS=
# Extra secrets are just more named vars, e.g.:
# APP_A_STG_KEY=

# BASE_URL is NOT set here — each environment supplies its own URL from the DB
# (bull-terra env add <project> <env> <url>). Don't override it manually.

# The Google Sheets MCP (terra-mcp / kozocom-mcp) is configured in Claude Code,
# not here. bull-terra never makes Google API calls itself.
