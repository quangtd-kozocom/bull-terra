# bull-terra — local secrets (gitignored). Copy to .env and fill in.
# Secrets stay OFF the Google Sheet and OFF git (PRD §14).

# Base URL the specs run against (overrides per project at runtime if set).
BASE_URL=https://your-app.example.com

# Login credentials used by tests/global-setup.ts to capture auth.json once.
# Use APP_<PROJECT>_USER / _PASS if you run multiple apps; global-setup reads
# APP_USER / APP_PASS by default — adjust to taste.
APP_USER=
APP_PASS=

# The Google Sheets MCP (terra-mcp / kozocom-mcp) is configured in Claude Code,
# not here. bull-terra never makes Google API calls itself.
