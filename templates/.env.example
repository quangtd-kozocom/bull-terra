# bull-terra — local secrets (gitignored). Copy to .env and fill in.
# Secrets stay OFF the Google Sheet and OFF git (PRD §14).
#
# bull-terra stores only the *names* of these vars on each environment
# (env add … --user-var APP_A_STG_USER --pass-var APP_A_STG_PASS). The values
# live here. At run time bull-terra reads them and injects BULL_TERRA_USER /
# BULL_TERRA_PASS into the test process, so global-setup never hardcodes which
# env it's logging into.
#
# Convention: APP_<PROJECT>_<ENV>_USER / _PASS — but any names you registered
# work. Several environments may point at the same pair to share a login.

# ── app-a ───────────────────────────────────────────────────────────────────
APP_A_LOCAL_USER=
APP_A_LOCAL_PASS=

APP_A_STG_USER=
APP_A_STG_PASS=

# BASE_URL is NOT set here — each environment supplies its own URL from the DB
# (bull-terra env add <project> <env> <url>). Don't override it manually.

# The Google Sheets MCP (terra-mcp / kozocom-mcp) is configured in Claude Code,
# not here. bull-terra never makes Google API calls itself.
